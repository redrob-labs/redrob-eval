      }
    },
    {
      "id": "regex/explicit-whitespace-class-excludes-nbsp",
      "description": "A no-break space is not in the class unless it is written into the class.",
      "verifier": {
        "type": "regex",
        "pattern": "[ \\t\\n\\r\\f\\v]+"
      },
      "candidate": " ",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/whitespace-class-including-nbsp",
      "verifier": {
        "type": "regex",
        "pattern": "[ \\u00a0]+"
      },
      "candidate": "  ",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/any-character-but-newline",
      "description": "[^\\n] is what '.' meant in Python. It means the same in JavaScript, which '.' did not.",
      "verifier": {
        "type": "regex",
        "pattern": "a[^\\n]b",
        "mode": "search"
      },
      "candidate": "a\nb",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/any-character-but-newline-accepts-cr",
      "description": "The divergence that banned the dot: Python's '.' matched a CR here and JavaScript's did not.",
      "verifier": {
        "type": "regex",
        "pattern": "a[^\\n]b",
        "mode": "search"
      },
      "candidate": "a\rb",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/any-character-at-all",
      "description": "[\\u0000-\\uffff] is what '.' with the s flag meant.",
      "verifier": {
        "type": "regex",
        "pattern": "a[\\u0000-\\uffff]b",
        "mode": "search"
      },
      "candidate": "a\nb",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/literal-dot-inside-a-class",
      "description": "A dot inside a character class is a literal in both engines and stays in the subset.",
      "verifier": {
        "type": "regex",
        "pattern": "[.]"
      },
      "candidate": ".",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/escaped-dot",
      "verifier": {
        "type": "regex",
        "pattern": "3\\.14"
      },
      "candidate": "3.14",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/escaped-dot-is-not-a-wildcard",
      "verifier": {
        "type": "regex",
        "pattern": "3\\.14"
      },
      "candidate": "3x14",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/caret-out-of-subset-start-anchor",
      "description": "Anchoring is the mode's job. '^' left the subset with '$': a half-anchored pattern is what pushed the previous revision into inventing an end-of-input assertion, and that assertion was the A1 defect.",
      "verifier": {
        "type": "regex",
        "pattern": "^a",
        "mode": "search"
      },
      "candidate": "abc",
      "expected": {
        "passed": false,
        "code": "invalid_pattern"
      }
    },
    {
      "id": "regex/caret-out-of-subset-inside-a-group",
      "description": "Rejected wherever it appears, not only at position zero.",
      "verifier": {
        "type": "regex",
        "pattern": "(^a|b)",
        "mode": "search"
      },
      "candidate": "abc",
      "expected": {
        "passed": false,
        "code": "invalid_pattern"
      }
    },
    {
      "id": "regex/case-insensitivity-is-written-out",
      "description": "What the 'i' flag used to do. Written as explicit alternatives it means the same thing in both engines, including under the u flag.",
      "verifier": {
        "type": "regex",
        "pattern": "[aA][bB][cC]"
      },
      "candidate": "AbC",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/explicit-class-does-not-fold-the-kelvin-sign",
      "description": "U+212A folds to 'k' under Python's IGNORECASE and under a JavaScript RegExp with 'iu'. With no folding at all there is nothing to disagree about.",
      "verifier": {
        "type": "regex",
        "pattern": "[a-z]+"
      },
      "candidate": "K",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/explicit-class-does-not-fold-the-dotless-i",
      "description": "U+0131 folds to 'i' under Python's IGNORECASE and not under 'iu'. This is the divergence that removed the flag; written out, both engines say no.",
      "verifier": {
        "type": "regex",
        "pattern": "[iI]"
      },
      "candidate": "ı",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/caseless-script-needs-no-flag",
