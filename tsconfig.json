{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // Several scripts already import a sibling as './thing.ts', which tsx resolves at
    // runtime but tsc rejected, so `tsc --noEmit` reported six errors on a clean checkout.
    // Safe here because this project only ever typechecks; it never emits.
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.mts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages"]
}
