# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/*/node_modules
packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
apps/web/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.*
!.env.example

# deploy secrets + measured GPU util (never commit)
deploy/.env
deploy/measured.env
deploy/measured.json

# caches (OpenRouter catalog, HF tokenizers, etc.)
.cache/
apps/web/.cache/

# vendored NC / local-only datasets (do not commit)
datasets/local/

# human-labeled skill footage manifests (paths outside repo — not redistributable)
datasets/video-local/*
!datasets/video-local/README.md
!datasets/video-local/example-checklist.schema.json

# Compare run artifacts (generated images) + preference tournaments
eval/runs/
eval/tournaments/

# routing-SLM collection (generated — keep .gitkeep)
eval/routing-runs/*
!eval/routing-runs/.gitkeep

# optimize runs (GEPA)
eval/optimize-runs/*
!eval/optimize-runs/.gitkeep
eval/preference-runs/*
!eval/preference-runs/.gitkeep
eval/routing-corpus/*
!eval/routing-corpus/.gitkeep
!eval/routing-corpus/README.md

# local training exports
exports/*
!exports/.gitkeep
!exports/samples/
!exports/samples/**

# router training artifacts / venv
train/artifacts/
.venv-train/
.venv-generate/
**/*.egg-info/
.pytest_cache/
**/__pycache__/
*.py[cod]
*.pt
*.bin
*.safetensors

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/web/next-env.d.ts

# parity research outputs (keep README + requirements)
scripts/parity/results/
