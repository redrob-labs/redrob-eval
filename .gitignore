.DS_Store
Thumbs.db
*.pem
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit secrets)
.env
.env.*
!.env.example

# vLLM endpoint registry (may hold per-host keys)
.redrob/

# Local Cursor / agent skill installs (not part of the product)
.agents/
skills-lock.json

# deploy secrets + measured GPU util (never commit)
deploy/.env
deploy/measured.env
deploy/measured.json

# caches (OpenRouter catalog, HF tokenizers, etc.)
.cache/
apps/web/.cache/

# vendored NC / local-only datasets (do not commit)
datasets/local/

# human-labeled skill footage manifests (paths outside repo — not redistributable)
datasets/video-local/*
!datasets/video-local/README.md
!datasets/video-local/example-checklist.schema.json

# Compare run artifacts (generated images) + preference tournaments
eval/runs/
eval/tournaments/

# Experiment registry (local history; the sqlite file and the fs driver's runs)
eval/registry/
eval/registry.sqlite
eval/registry.sqlite-journal

# routing-SLM collection (generated — keep .gitkeep)
eval/routing-runs/*
!eval/routing-runs/.gitkeep

# optimize runs (GEPA)
eval/optimize-runs/*
!eval/optimize-runs/.gitkeep
eval/preference-runs/*
!eval/preference-runs/.gitkeep
eval/routing-corpus/*
!eval/routing-corpus/.gitkeep
!eval/routing-corpus/README.md

# local training exports
exports/*
!exports/.gitkeep
!exports/samples/
!exports/samples/**

# router training artifacts / venv
train/artifacts/
.venv-train/
.venv-generate/
**/*.egg-info/
.pytest_cache/
**/__pycache__/
*.py[cod]
*.pt
*.bin
*.safetensors

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
apps/web/next-env.d.ts

# parity research outputs (keep README + requirements)
scripts/parity/results/

# build and test output from development tasks. Published *evaluation* run logs are a
# different thing entirely and belong versioned with a manifest; this is the transcript of
# a build, which is reproducible by re-running the build. CI uploads it as a workflow
# artifact instead, so it stays inspectable without entering history.
#
# The end-of-pass reports are the exception, and by that rationale they always were: a
# report is written by hand, is not reproducible by re-running anything, and is the only
# record of why a pass made the choices it did. Earlier ones stayed untracked because this
# rule caught them by accident. `logs/*` rather than `logs/` because git will not re-include
# a file whose parent directory is itself excluded.
logs/*
!logs/SUMMARY*.md

# Screenshots and recordings taken while checking a change by hand. Evidence for a review,
# reproducible by looking again, and already uploaded where the review can see it. One
# reached a release tag through `git add -A`, which is the only way this directory ever
# gets staged.
.artifacts/
