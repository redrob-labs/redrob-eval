        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/ignore-case-does-not-fold-the-kelvin-sign",
      "description": "U+212A folds to 'k' under Python's default IGNORECASE, and not under re.ASCII or a JavaScript RegExp without the u flag. Confining 'i' to ASCII patterns and compiling Python under re.ASCII makes the two agree.",
      "verifier": {
        "type": "regex",
        "pattern": "[a-z]+",
        "flags": [
          "i"
        ]
      },
      "candidate": "K",
      "expected": {
        "passed": false,
