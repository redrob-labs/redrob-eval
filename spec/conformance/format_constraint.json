    },
    {
      "id": "format/full-release-note-shape",
      "description": "The shape the format.release_note template actually asks for.",
      "verifier": {
        "type": "format_constraint",
        "min_length": 80,
        "max_length": 400,
        "min_lines": 4,
        "max_lines": 4,
        "required_substrings": ["gateway 3.1.4"],
        "forbidden_substrings": ["seamless", "Seamless"],
        "trim": true
      },
      "candidate": "gateway 3.1.4\n- Reduced request queueing under sustained load.\n- Fixed a header parsing bug on chunked uploads.\n- Upgraded the TLS stack to the current release.\n",
