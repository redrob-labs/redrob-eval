        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "all_of/zwj-sequence-fails-the-second-child-when-unjoined",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "format_constraint",
            "max_length": 5
          },
          {
            "type": "exact",
            "expected": "👩‍👩‍👧"
          }
        ]
      },
      "candidate": "👩👩👧",
      "expected": {
        "passed": false,
        "code": "mismatch"
      }
    },
    {
      "id": "all_of/mixed-script-passes-a-schema-and-a-format-check",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "json_schema",
            "schema": {
              "type": "object",
              "required": ["greeting"],
              "properties": {
                "greeting": {
                  "const": "नमस्ते"
                }
              }
            }
          },
          {
            "type": "format_constraint",
            "forbidden_substrings": [" "]
          }
        ]
      },
      "candidate": "{\"greeting\":\"नमस्ते\"}",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    }
  ],
  "rejections": [
    {
      "id": "all_of/rejects-sympy-equiv-child",
      "description": "An executable child makes the whole composite unsupported.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "sympy_equiv",
            "expected": "x + 1",
            "symbols": ["x"]
          }
        ]
      },
      "candidate": "x + 1",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-python-unittest-child",
      "description": "The other executable type, refused the same way.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "python_unittest",
            "test_source": "import unittest\n"
          }
        ]
      },
      "candidate": "def f(): pass",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-after-passing-declarative",
      "description": "The declarative child would pass; the composite must still refuse rather than report ok.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "exact",
            "expected": "42"
          },
          {
            "type": "sympy_equiv",
            "expected": "x + 1",
            "symbols": ["x"]
          }
        ]
      },
      "candidate": "42",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-after-failing-declarative",
      "description": "The eager case. A lazy implementation returns the first child's mismatch and never looks at the executable sibling, reporting a verdict for output it only partially checked.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "exact",
            "expected": "not the candidate"
          },
          {
            "type": "sympy_equiv",
            "expected": "x + 1",
            "symbols": ["x"]
          }
        ]
      },
      "candidate": "42",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-before-declarative",
      "description": "Order does not matter; the walk covers every child.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "sympy_equiv",
            "expected": "x + 1",
            "symbols": ["x"]
          },
          {
            "type": "exact",
            "expected": "42"
          }
        ]
      },
      "candidate": "42",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-nested-one-deep",
      "description": "Nesting does not launder an executable child.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "exact",
            "expected": "42"
          },
          {
            "type": "all_of",
            "verifiers": [
              {
                "type": "sympy_equiv",
                "expected": "x + 1",
                "symbols": ["x"]
              }
            ]
          }
        ]
      },
      "candidate": "42",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-nested-two-deep",
      "description": "Still refused two levels down.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "all_of",
            "verifiers": [
              {
                "type": "all_of",
                "verifiers": [
                  {
                    "type": "python_unittest",
                    "test_source": "import unittest\n"
                  }
                ]
              }
            ]
          }
        ]
      },
      "candidate": "42",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-nested-two-deep-behind-a-failure",
      "description": "Eager at depth as well: the failing sibling must not short-circuit the walk.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "exact",
            "expected": "not the candidate"
          },
          {
            "type": "all_of",
            "verifiers": [
              {
                "type": "all_of",
                "verifiers": [
                  {
                    "type": "sympy_equiv",
                    "expected": "x + 1",
                    "symbols": ["x"]
                  }
                ]
              }
            ]
          }
        ]
      },
      "candidate": "42",
      "raises": "unsupported_verifier",
      "expected": {
        "passed": false,
        "code": "unsupported_verifier"
      }
    },
    {
      "id": "all_of/rejects-executable-at-maximum-permitted-depth",
      "description": "Depth 8 is the deepest a composite may nest, and an executable verifier is refused there too, which is the last place a walk that gives up early would miss.",
      "verifier": {
        "type": "all_of",
        "verifiers": [
          {
            "type": "all_of",
            "verifiers": [
              {
                "type": "all_of",
                "verifiers": [
                  {
                    "type": "all_of",
