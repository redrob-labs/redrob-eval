{
  "spec_version": "redrob-verifiable-task/v1",
  "verifier_type": "regex",
  "description": "Pattern matching over the portable regex subset. The subset has no shorthand classes, no '.', no anchors and no flags, because each of those means something different in Python re and in a JavaScript RegExp. Matching is by code point on both sides: the TypeScript implementation compiles with the u flag, and the astral rows below are what hold it to that.",
  "cases": [
    {
      "id": "regex/full-match-literal",
      "description": "The baseline.",
      "verifier": {
        "type": "regex",
        "pattern": "abc"
      },
      "candidate": "abc",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/full-match-requires-whole-string",
      "verifier": {
        "type": "regex",
        "pattern": "abc"
      },
      "candidate": "abcd",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/full-match-refuses-a-trailing-newline",
      "description": "full_match is Python's fullmatch and JavaScript's ^(?:...)$ without the m flag. Neither tolerates a trailing newline, which is why the subset does not need '$'.",
      "verifier": {
        "type": "regex",
        "pattern": "abc"
      },
      "candidate": "abc\n",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/search-anywhere",
      "verifier": {
        "type": "regex",
        "pattern": "abc",
        "mode": "search"
      },
      "candidate": "xxabcxx",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/empty-pattern-empty-candidate",
      "verifier": {
        "type": "regex",
        "pattern": ""
      },
      "candidate": "",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/empty-pattern-nonempty-candidate",
      "verifier": {
        "type": "regex",
        "pattern": ""
      },
      "candidate": "a",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/explicit-digit-class",
      "description": "What \\d used to be written as.",
      "verifier": {
        "type": "regex",
        "pattern": "[0-9]+"
      },
      "candidate": "12345",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/explicit-digit-class-excludes-devanagari-digits",
      "description": "[0-9] means the ASCII ten and says so. The point of banning \\d is not that this answer is wrong, it is that \\d gave this answer while looking like it meant 'digits'.",
      "verifier": {
        "type": "regex",
        "pattern": "[0-9]+"
      },
      "candidate": "१२३",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/devanagari-digit-class",
      "description": "The Devanagari digits, named explicitly. Unreachable through \\d under either engine's reading.",
      "verifier": {
        "type": "regex",
        "pattern": "[\\u0966-\\u096f]+"
      },
      "candidate": "१२३",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/devanagari-letter-class",
      "description": "नमस्ते. Every code point is in the Devanagari block, including the virama and the vowel sign.",
      "verifier": {
        "type": "regex",
        "pattern": "[\\u0900-\\u097f]+"
      },
      "candidate": "नमस्ते",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/devanagari-class-excludes-latin",
      "verifier": {
        "type": "regex",
        "pattern": "[\\u0900-\\u097f]+"
      },
      "candidate": "namaste",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/hangul-syllable-class",
      "description": "한글, precomposed syllables.",
      "verifier": {
        "type": "regex",
        "pattern": "[\\uac00-\\ud7a3]+"
      },
      "candidate": "한글",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/hangul-jamo-class",
      "description": "The same word written as conjoining jamo, which lives in a different block and needs a different class.",
      "verifier": {
        "type": "regex",
        "pattern": "[\\u1100-\\u11ff]+"
      },
      "candidate": "한",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/hangul-syllable-class-excludes-jamo",
      "description": "Precomposed and decomposed Hangul are not interchangeable to a regex. A verifier that must accept both needs both classes, and making that visible is the argument for explicit classes.",
      "verifier": {
        "type": "regex",
        "pattern": "[\\uac00-\\ud7a3]+"
      },
      "candidate": "한",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/hangul-class-excludes-latin",
      "verifier": {
        "type": "regex",
        "pattern": "[\\uac00-\\ud7a3]+"
      },
      "candidate": "hangeul",
      "expected": {
        "passed": false,
        "code": "no_match"
      }
    },
    {
      "id": "regex/hinglish-mixed-script-class",
      "description": "Hinglish in one class: Latin, Devanagari and a space. \\w would have accepted the Latin half and rejected the rest.",
      "verifier": {
        "type": "regex",
        "pattern": "[a-zA-Z\\u0900-\\u097f ]+"
      },
      "candidate": "main ठीक hoon",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/explicit-word-class",
