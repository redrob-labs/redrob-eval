{
  "name": "redrob-eval",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Janghoon Lee",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @redrob/web dev",
    "build": "yarn workspace @redrob/harness typecheck && yarn workspace @redrob/web build",
    "typecheck": "yarn workspace @redrob/harness typecheck && yarn workspace @redrob/tokenizers typecheck",
    "start": "yarn workspace @redrob/web start",
    "lint": "yarn workspace @redrob/web lint",
    "probe": "node scripts/probe.mjs",
    "verify:phase1": "tsx scripts/verify-phase1.mts",
    "verify:gepa": "tsx scripts/verify-gepa.mts",
    "verify:phase3": "tsx scripts/verify-phase3.mts",
    "verify:custom-goal": "tsx scripts/verify-custom-goal.mts",
    "verify:video": "tsx scripts/verify-video.mts",
    "verify:compare": "tsx scripts/verify-compare.mts",
    "verify:tournament": "tsx scripts/verify-tournament.mts",
    "verify:selfhosted": "tsx scripts/verify-selfhosted.mts",
    "verify:preference-gen": "tsx scripts/verify-preference-gen.mts",
    "export:samples": "tsx scripts/export-samples.mts",
    "export:routing": "tsx scripts/export-routing.mts",
    "datasets:fetch": "tsx scripts/datasets/fetch.mts",
    "train:mlp": "python train/mlp_train.py --data train/fixtures/sample-flat.jsonl",
    "train:mlp:corpus": "python train/mlp_train.py --data exports/routing-flat.jsonl",
    "train:event-detect": "python train/event_detect_train.py --data train/fixtures/sample-event-frames.jsonl",
    "train:compare": "python train/compare.py --data train/fixtures/sample-flat.jsonl",
    "train:slm": "python train/slm_train.py --data train/fixtures/sample-chat.jsonl --max-samples 8 --epochs 1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
