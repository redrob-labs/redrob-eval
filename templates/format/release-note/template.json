{
  "spec_version": "redrob-verifiable-task/v2",
  "id": "format.release_note",
  "version": "1.0.0",
  "family": "format",
  "parameters": [
    { "name": "component", "type": "choice", "choices": ["scheduler", "indexer", "gateway", "compactor", "planner", "resolver"] },
    { "name": "major", "type": "integer", "min": 1, "max": 9 },
    { "name": "minor", "type": "integer", "min": 0, "max": 30 },
    { "name": "patch", "type": "integer", "min": 0, "max": 40 },
    { "name": "bullet_count", "type": "integer", "min": 3, "max": 6 },
    { "name": "max_chars", "type": "integer", "min": 320, "max": 600 },
    { "name": "banned_word", "type": "choice", "choices": ["seamless", "robust", "leverage", "synergy", "cutting-edge", "revolutionary"] }
  ],
  "derivations": [
    { "name": "version", "expr": "f\"{major}.{minor}.{patch}\"" },
    { "name": "header", "expr": "f\"{component} {version}\"" },
    { "name": "total_lines", "expr": "bullet_count + 1" }
  ],
  "verifier": [
    {
      "type": "format_constraint",
      "min_length": 80,
      "max_length": "{{max_chars}}",
      "min_lines": "{{total_lines}}",
      "max_lines": "{{total_lines}}",
      "required_substrings": ["{{header}}"],
      "case_sensitive": true,
      "trim": true,
      "normalize_line_endings": true
    },
    {
      "type": "format_constraint",
      "forbidden_substrings": ["{{banned_word}}"],
      "case_sensitive": false,
      "trim": true,
      "normalize_line_endings": true
    }
  ],
  "notes": "Two elements because case_sensitive applies to every substring check in one format_constraint at once: the header must match its exact casing and the banned word must be caught in any casing. Under the combinator this replaces, the template listed the banned word twice, in two casings picked by a derivation, which caught Seamless and seamless and missed SEAMLESS. Splitting the constraint is what the list form is for, and it is also why the two checks are now reported separately."
}
