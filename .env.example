# Copy to repo-root `.env` and fill only the providers you use.
# Keys stay on the server — never sent to the browser.
# Next loads this file via apps/web/next.config.ts (monorepo).

# Optional: Hugging Face token (needed for gated datasets like ai4bharat/IN22-Gen).
# Without it, IN22-Gen falls back to the ungated mteb/IN22-Gen mirror.
# HF_TOKEN=

# Required for OpenRouter catalog, text dual-eval collection, image gen, vision judge
OPENROUTER_API_KEY=

# Direct providers (optional — enable whichever you have)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# Optional overrides (defaults work for most setups)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Self-hosted vLLM, called directly on the GPU host. See deploy/.
# Inject via environment only; never commit real values.
# Local bearer for vLLM --api-key (not Hugging Face). Auto-issued by Deploy if unset.
# The port is open, so this key is the only thing guarding the endpoint.
# VLLM_API_KEY=
# vLLM's conventional port is 8000. Slot n listens on VLLM_PORT+n (8000, 8001, …).
# Change the base when the host already uses 8000.
# VLLM_PORT=8000
# Defaults to http://localhost:8000/v1. Set it to the GPU host (e.g.
# http://your-host:8000/v1) to reach remote slot 0. Slot n is derived from this
# by adding n to the port, so a second deployed model shows up in Compare with
# no further settings; it is also auto-added to the vLLM hosts registry.
# VLLM_BASE_URL=
# Only for hosts where the slots are not consecutive ports: servedName=baseUrl
# pairs, comma separated. Overrides the derivation above.
# VLLM_SLOT_URLS=redrob-s0=http://a:9000/v1,redrob-s1=http://b:9100/v1

# GPU host deploy (UI-driven /deploy over SSH). Values injected via env only.
# GPU_HOST=
# GPU_USER=
# GPU_SSH_KEY=
# GPU_SSH_PORT=22
# Mirrored from the GPU host by /deploy — do not hand-write these.
# MEASURED_MODEL_HF=
# MEASURED_TOK_PER_SEC=
# MEASURED_PRECISION=bf16
# MEASURED_AT=

# Optional Generate CLI. Point at an editable install inside a virtualenv when
# `redrob-generate` is not on PATH. Example (Windows):
# REDROB_GENERATE_CMD=C:/path/to/redrob-eval/.venv-generate/Scripts/redrob-generate.exe
# Example (macOS / Linux):
# REDROB_GENERATE_CMD=/path/to/redrob-eval/.venv-generate/bin/redrob-generate
