        "pattern": "[a-zA-Z\\u0900-\\u097f ]+"
      },
      "candidate": "main ठीक hoon",
      "expected": {
        "passed": true,
        "code": "ok"
      }
    },
    {
      "id": "regex/explicit-word-class",
